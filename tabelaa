import os
def limpar():
    os.system("cls")
limpar()
from rich import print
from rich.panel import Panel


# 2:
while True:
    conteudo = ( 
    "===== Menu =====\n"
    "1 –  Jogo do dado"
    "2 – Cálculo de Raiz e Potência"
    "3 – Manipulação de Texto"
    "4 – Sair")

    # 3:
  
    opcao = (input("Selecione uma opção: "))

    if opcao == "1":
        limpar()
        from random import randint
        from time import sleep
        dado = randint(1,60)
        print("Você jogou o dado..")
        sleep(2)
        print(f"O dado caiu no número {dado}")
        sleep(2)
        

    # 4:
    elif opcao == "2":
     limpar()
     import math 
     from time import sleep
     print("1 – Raiz")
     print("2 – Potencia")

     expressao = input("Escolha qual expressão matemática utilizara: ")
     if expressao == "1":
         limpar()
         print("===== Raiz =====\n")
         numero = float(input("Digite um número para saber sua raiz: "))
         raiz = math.sqrt(numero)
         print(f"A raiz de {numero} = {raiz}\n")
         
    
     elif expressao == "2":
         limpar()
         print("===== Potencia =====\n")
         base = float(input("Digite a base: "))
         expoente = float(input("Digite o expoente: "))
         resultado = math.pow(base, expoente)
         print(f"{base} elevado a {expoente} = {resultado}\n")
    
    # 5:
     
    elif opcao == "3":
      from time import sleep
      limpar()
      print("===== Manipulação De Texto =====\n")
      texto = input("Digite um texto: ")
      print(f"{texto} em maiúsculo:", texto.upper())
      sleep(1)
      print(f"{texto} em minúsculo:", texto.lower())
